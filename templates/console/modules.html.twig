{% extends '@UhifadhiDevkit/console/base.html.twig' %}
{% import '@UhifadhiDevkit/console/_parts.html.twig' as parts %}

{% set devkit_tab = 'modules' %}

{% block title %}Modules{% endblock %}
{% block shell_page_title %}Modules{% endblock %}
{% block shell_page_subtitle %}
    The installed fleet, in one register &mdash; every module with its version,
    whether it pins the current core, how many permissions and routes it declares,
    and where it is switched on. This is the authoritative registry the
    compatibility matrix and doctor read from; the Doctor surface turns these same
    facts into pass / warn / fail.
{% endblock %}

{% block devkit_content %}
    {% set query = filter|merge(matrixFilter) %}
    {% set coreBase = query|filter((v, k) => k != 'core' and k != 'page') %}
    {% set coreOptions = [{label: 'all', count: registry.rows|length, query: coreBase, on: filter.core is not defined}] %}
    {% for key, label in {on: 'on core', behind: 'behind core', na: 'n/a'} %}
        {% set coreOptions = coreOptions|merge([{label: label, count: coreCounts[key] ?? 0, query: coreBase|merge({core: key}), on: (filter.core ?? null) == key}]) %}
    {% endfor %}

    <h2 class="zone">The registry</h2>
    <div class="c" style="padding:16px 16px 6px">
        {{ parts.bar(query, parts.chip('on core', 'Filter by core', coreOptions), 'q', 'page', 'Find a module') }}
        {{ parts.registry_table(rows, matrix) }}
        {{ include('@Shell/_foot.html.twig', {
            count: table.total, noun: 'packages', one: 'package',
            perPage: table.size, page: table.page, pages: table.pages, links: links,
        }, with_context: false) }}
    </div>

    <h2 class="zone">Per-area module state</h2>
    {% if matrix %}
        {% set every = matrix.rows|length - matrix.perAreaCount %}
        <p class="pgsub">{{ every }} {{ every == 1 ? 'module is' : 'modules are' }} on in every area. {{ matrix.perAreaCount }} {{ matrix.perAreaCount == 1 ? 'is' : 'are' }} switched on per area.</p>
        {% set reachBase = query|filter((v, k) => k != 'reach' and k != 'mpage') %}
        <div class="c" style="padding:16px 16px 6px">
            {{ parts.bar(query, parts.chip('reach', 'Filter by reach', [
                {label: 'all', count: matrix.rows|length, query: reachBase, on: matrixFilter.reach is not defined},
                {label: 'per area', count: matrix.perAreaCount, query: reachBase|merge({reach: 'per'}), on: (matrixFilter.reach ?? null) == 'per'},
                {label: 'every area', count: every, query: reachBase|merge({reach: 'every'}), on: (matrixFilter.reach ?? null) == 'every'},
            ]), 'mq', 'mpage', 'Find a module') }}
            <table class="tbl dk-areas">
                <thead><tr><th>module</th>{% for name in matrix.areas %}<th class="dk-c">{{ name }}</th>{% endfor %}</tr></thead>
                <tbody>
                {% for row in matrixRows %}
                    <tr>
                        <td><b>{{ row.label }}</b><div class="dk-pkg">{{ row.version }} &middot; {{ row.perArea ? 'per area · on in ' ~ row.onCount ~ ' of ' ~ matrix.areas|length ~ (matrix.areas|length == 1 ? ' area' : ' areas') : 'every area' }}</div></td>
                        {% for uuid, name in matrix.areas %}
                            <td class="dk-c">{% if row.on[uuid] %}<span class="dk-cell pass">&#10003;</span>{% else %}<span class="dk-cell na">&ndash;</span>{% endif %}</td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr><td colspan="{{ matrix.areas|length + 1 }}"><span class="mono d">{{ matrix.rows is empty ? 'No module is installed.' : 'No module matches these filters.' }}</span></td></tr>
                {% endfor %}
                </tbody>
            </table>
            {{ include('@Shell/_foot.html.twig', {
                count: matrixTable.total, noun: 'modules', one: 'module',
                perPage: matrixTable.size, page: matrixTable.page, pages: matrixTable.pages, links: matrixLinks,
            }, with_context: false) }}
        </div>
    {% else %}
        <p class="pgsub">This installation has no per-area ledger to read &mdash; the registry and a database keep one &mdash; so where each module is switched on is not drawn here.</p>
    {% endif %}
{% endblock %}
