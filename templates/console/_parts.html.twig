{# Shared console fragments — the assembled command list and the conformance
   matrix — so the home surface and the Commands / Doctor surfaces draw them
   identically. Kept as macros rather than includes because each takes the value
   objects the introspection services assemble. #}

{# One module-provenance dot. One hue per contributor, reused across surfaces
   (see devkit.css). Unknown contributors take the neutral host hue. #}
{% macro dot(short) %}
    {%- set known = {'patrol': 'd-patrol', 'incident': 'd-incident', 'map': 'd-map', 'storage': 'd-storage', 'roster': 'd-roster', 'uhifadhi': 'd-storage'} -%}
    <span class="dot {{ known[short]|default('d-host') }}"></span>
{% endmacro %}

{# The disabled CLI Run affordance — drawn, deliberately inert: v1 reads and
   assembles, commands run from the CLI. #}
{% macro run() %}
    <button class="dk-run" disabled title="v1 runs commands from the CLI"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg> Run <span class="cli">CLI</span></button>
{% endmacro %}

{# One assembled command row. #}
{% macro command(cmd) %}
    {% import _self as parts %}
    <div class="dk-cmd{{ cmd.deprecated ? ' dep' }}">
        <div class="bd">
            <div class="nm">{{ cmd.name }} <span class="kind{{ cmd.kind.value == 'seed-content' ? ' content' }}">{{ cmd.kind.value }}</span></div>
            <div class="ds">{{ cmd.description }}</div>
        </div>
        {{ parts.run() }}
    </div>
{% endmacro %}

{# One contributing module's group of commands: the header, then its rows. #}
{% macro group(grp) %}
    {% import _self as parts %}
    <div class="dk-grp">{{ parts.dot(grp.label) }}<span class="gn">{{ grp.label }}</span><span class="pkg">{{ grp.package ? grp.package.name ~ ' · ' ~ grp.package.version : 'app-level' }}</span><span class="cnt">{{ grp.count }}</span><span class="ln"></span></div>
    {% for cmd in grp.commands %}{{ parts.command(cmd) }}{% endfor %}
{% endmacro %}

{# The module registry table — the fleet as one register. Shared by the home
   surface and the Modules surface so they can never disagree. `matrix` is
   the per-area state where the installation keeps a ledger, or null. #}
{% macro registry_table(rows, matrix = null) %}
    <table class="tbl">
        <thead><tr><th>module</th><th>version</th><th>requires contracts</th><th>on core</th><th class="num">permissions</th><th class="num">routes</th><th>on in areas</th><th></th></tr></thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td><span class="dk-name">{{ row.package.shortName }}</span><div class="dk-pkg">{{ row.package.name }}</div></td>
                <td><span class="dk-ver">{{ row.package.version }}</span></td>
                <td>
                    {%- if row.reach.name == 'TheCore' %}<span class="dk-con">is the core</span>
                    {%- elseif row.coreConstraint is null %}<span class="dk-con">&mdash;</span>
                    {%- else %}<span class="dk-con{{ row.coreState.name == 'BehindCore' ? ' w' }}">{{ row.coreConstraint }}</span>
                    {%- endif %}
                </td>
                <td>
                    {%- if row.coreState.name == 'OnCore' %}<span class="chip ok">on core</span>
                    {%- elseif row.coreState.name == 'BehindCore' %}<span class="chip warn">behind core</span>
                    {%- else %}<span class="chip idle">n/a</span>
                    {%- endif %}
                </td>
                <td class="num">{{ row.grants }}</td>
                <td class="num">{{ row.routes }}</td>
                <td>
                    {%- set on = matrix ? matrix.onCount(row.slug) : null -%}
                    {%- if row.reach.name == 'TheCore' %}<span class="dk-on zero"><i></i>the core</span>
                    {%- elseif row.reach.name == 'HostWide' %}<span class="dk-on"><i></i>every area</span>
                    {%- elseif on is not null %}<span class="dk-on{{ on == 0 ? ' zero' }}"><i></i>on in {{ on }} / {{ matrix.areas|length }}</span>
                    {%- else %}<span class="dk-on zero"><i></i>per area</span>
                    {%- endif %}
                </td>
                <td><a class="open-btn" href="{{ path('devkit_console_modules') }}">Open</a></td>
            </tr>
        {% else %}
            <tr><td colspan="8"><span class="mono d">No module matches these filters.</span></td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{# THE HOUSE BAR AND FOOT — the shell's `.lfilt` and `.rdf-foot`, every
   choice a link or one GET form. `query` is the page's whole query, so a
   choice in one table's bar or foot keeps the other table's. #}

{# options: list of {label, count, query, on} #}
{% macro chip(head, aria, options) %}
    {%- set picked = options|filter(o => o.on)|first|default(options|first) -%}
    <details class="i-dd">
        <summary class="mchip i-ddt{{ picked != options|first ? ' on' }}"><span class="i-ddval">{{ picked.label }} &middot; {{ picked.count }}</span><span class="i-ddcaret">&#9662;</span></summary>
        <div class="i-ddmenu" aria-label="{{ aria }}">
            <span class="i-ddhead">{{ head }}</span>
            {%- for option in options -%}
                {%- if loop.index == 2 %}<span class="i-ddsep"></span>{% endif -%}
                <a class="i-ddopt{{ option.on ? ' on' }}" href="{{ path('devkit_console_modules', option.query) }}"><span class="i-ddopt-l">{{ option.label }}</span><span class="i-ddopt-n">{{ option.count }}</span></a>
            {%- endfor -%}
        </div>
    </details>
{% endmacro %}

{% macro bar(query, chips, qKey, pageKey, placeholder) %}
    <form class="lfilt" method="get" action="{{ path('devkit_console_modules') }}">
        {%- for name, value in query|filter((v, k) => k != qKey and k != pageKey) -%}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {%- endfor -%}
        {{ chips|raw }}
        <div class="lsearch">{{ ux_icon('shell:search', {width: 14, height: 14, 'aria-hidden': 'true'}) }}<input class="fld" type="search" name="{{ qKey }}" value="{{ query[qKey] ?? '' }}" placeholder="{{ placeholder }}" aria-label="{{ placeholder }}" autocomplete="off"></div>
    </form>
{% endmacro %}

{% macro foot(table, query, sizeKey, pageKey, noun, nouns) %}
    {%- set kept = query|filter((v, k) => k != sizeKey and k != pageKey) -%}
    <div class="rdf-foot">
        <span>{{ table.total }} {{ table.total == 1 ? noun : nouns }} &middot; <details class="i-dd rdf-size"><summary><span class="pg">{{ table.size == 'all' ? 'All' : table.size }}</span> per page<span class="i-ddcaret">&#9662;</span></summary><div class="i-ddmenu" aria-label="Rows per page">
            {%- for size in constant('Uhifadhi\\Devkit\\Console\\Table\\TablePager::SIZES') -%}
                <a class="i-ddopt{{ size == table.size ? ' on' }}" href="{{ path('devkit_console_modules', kept|merge({(sizeKey): size})) }}"><span class="i-ddopt-l">{{ size == 'all' ? 'All' : size }}</span></a>
            {%- endfor -%}
        </div></details></span>
        <span class="rdf-page">page <span class="pg">{{ table.page }}</span> of {{ table.pages }}
            {%- if table.hasPrevious() %}<a href="{{ path('devkit_console_modules', query|merge({(pageKey): table.page - 1})) }}" aria-label="Previous page">&lsaquo;</a>{% endif -%}
            {%- if table.hasNext() %}<a href="{{ path('devkit_console_modules', query|merge({(pageKey): table.page + 1})) }}" aria-label="Next page">&rsaquo;</a>{% endif -%}
        </span>
    </div>
{% endmacro %}

{# One conformance-matrix cell — one colour, one meaning, never decorative. #}
{% macro cell(state) %}
    {%- set glyphs = {
        'pass': '<span class="dk-cell pass">&#10003;</span>',
        'warn': '<span class="dk-cell warn">!</span>',
        'fail': '<span class="dk-cell fail">&#10007;</span>',
        'na': '<span class="dk-cell na">&ndash;</span>',
        'deferred': '<span class="dk-cell na" title="devkit does not read this check yet — deferred">?</span>',
    } -%}
    {{ glyphs[state.value]|raw }}
{% endmacro %}

{# The icon for a check state — one glyph per meaning. #}
{% macro check_icon(state) %}
    {%- if state.value == 'pass' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    {%- elseif state.value == 'warn' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
    {%- elseif state.value == 'fail' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
    {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
    {%- endif -%}
{% endmacro %}

{# One doctor finding card. #}
{% macro finding(f) %}
    {% import _self as parts %}
    <div class="dk-check {{ f.state.value }}"><span class="ic">{{ parts.check_icon(f.state) }}</span><div class="bd"><div class="t">{{ f.title }}</div><div class="m">{{ f.message }}</div>{% if f.where %}<div class="who">{{ f.where }}</div>{% endif %}</div></div>
{% endmacro %}

{# The compatibility matrix — rows are modules, columns are the checks. #}
{% macro matrix(rows, checks) %}
    {% import _self as parts %}
    <table class="dk-mx">
        <tr><th class="rowhd">module</th>{% for check in checks %}<th>{{ check.header }}<br>{{ check.subheader }}</th>{% endfor %}</tr>
        {% for row in rows %}
            <tr><td class="rowhd"><span class="dk-name">{{ row.package.shortName }}</span></td>{% for check in checks %}<td>{{ parts.cell(row.cell(check)) }}</td>{% endfor %}</tr>
        {% endfor %}
    </table>
{% endmacro %}
